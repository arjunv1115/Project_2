# Copy this file to ".env" and fill in your values.

NODE_ENV=development
PORT=5000

# Browser origins allowed to call the API (comma separated).
# Not needed when the React app is served by this server or via the Vite proxy.
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=smart_ideal_db
DB_CONNECTION_LIMIT=10

# Contact form rate limit: max submissions per IP in the time window
CONTACT_RATE_WINDOW_MIN=15
CONTACT_RATE_MAX=5
