# Public site address, used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.smartidealtechnologies.com

# Where the browser sends API requests.
# "/api" works in development (Vite proxy) and in production when Express serves the site.
VITE_API_URL=/api

# Development only: where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:5000

# Optional: text Google Maps should search for. Defaults to the address in src/data/site.js.
# VITE_MAP_QUERY=Smart Ideal Technologies, PACIFICA TECH PARK, Navalur, Tamil Nadu 600130
